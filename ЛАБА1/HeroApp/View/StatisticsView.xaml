<Window x:Class="HeroApp.WPF.View.StatisticsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Статистика героев" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="LightBlue" Padding="15">
            <StackPanel>
                <TextBlock Text="📊 Статистика героев" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding TotalHeroes, StringFormat='Всего героев в базе: {0}'}" 
                           HorizontalAlignment="Center" 
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="📈 Общая">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <Border Background="WhiteSmoke" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Средняя сила:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" 
                                           Text="{Binding AverageStrength, StringFormat=F1}"
                                           Margin="10,0,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Среднее HP:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" 
                                           Text="{Binding AverageHp, StringFormat=F1}"
                                           Margin="10,0,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Максимальная сила:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" 
                                           Text="{Binding MaxStrength}"
                                           Margin="10,0,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Минимальное HP:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" 
                                           Text="{Binding MinHp, StringFormat=F1}"
                                           Margin="10,0,0,0"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Раненые герои (HP &lt; 50):" FontWeight="Bold"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" 
                                           Text="{Binding WoundedHeroesCount}"
                                           Foreground="Red"
                                           Margin="10,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Диаграмма силы по типам урона -->
                        <Border Background="White" Padding="10" CornerRadius="5" BorderThickness="1" BorderBrush="LightGray">
                            <StackPanel>
                                <TextBlock Text="💪 Распределение силы по типам урона" 
                                           FontWeight="Bold" 
                                           FontSize="14"
                                           Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding DamageTypeStatistics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2" Padding="5" Background="LightBlue" CornerRadius="3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding DamageType}" 
                                                               FontWeight="Bold"
                                                               Width="100"/>

                                                    <ProgressBar Grid.Column="1" 
                                                                 Value="{Binding AverageStrength}"
                                                                 Maximum="{Binding MaxDamageTypeStrength}"
                                                                 Height="20"
                                                                 Margin="10,0"
                                                                 Background="LightGray">
                                                        <ProgressBar.Foreground>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="LightGreen" Offset="0"/>
                                                                <GradientStop Color="Green" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </ProgressBar.Foreground>
                                                    </ProgressBar>

                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding AverageStrength, StringFormat={}{0:F1}}"
                                                               FontWeight="Bold"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="👥 По расам">
                <DataGrid ItemsSource="{Binding SpeciesStatistics}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Раса" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Средняя сила" Binding="{Binding AverageStrength, StringFormat=F1}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Среднее HP" Binding="{Binding AverageHp, StringFormat=F1}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Процент" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ProgressBar Value="{Binding Percentage}" 
                                                     Maximum="100"
                                                     Height="20"
                                                     Background="LightGray">
                                            <ProgressBar.Foreground>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="LightBlue" Offset="0"/>
                                                    <GradientStop Color="Blue" Offset="1"/>
                                                </LinearGradientBrush>
                                            </ProgressBar.Foreground>
                                        </ProgressBar>
                                        <TextBlock Text="{Binding Percentage, StringFormat={}{0:F1}%}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Статистика по гендерам -->
            <TabItem Header="🚻 По гендерам">
                <DataGrid ItemsSource="{Binding GenderStatistics}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Гендер" Binding="{Binding Gender}" Width="150"/>
                        <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Процент" Binding="{Binding Percentage, StringFormat=F1}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Диаграмма" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ProgressBar Value="{Binding Percentage}" 
                                                     Maximum="100"
                                                     Height="20"
                                                     Background="LightGray">
                                            <ProgressBar.Foreground>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="LightPink" Offset="0"/>
                                                    <GradientStop Color="HotPink" Offset="1"/>
                                                </LinearGradientBrush>
                                            </ProgressBar.Foreground>
                                        </ProgressBar>
                                        <TextBlock Text="{Binding Percentage, StringFormat={}{0:F1}%}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="🏥 Раненые (HP &lt; 50)">
                <DataGrid ItemsSource="{Binding WoundedHeroes}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="Раса" Binding="{Binding SpeciesName}" Width="100"/>
                        <DataGridTextColumn Header="HP" Width="80" Binding="{Binding Hp, StringFormat=F1}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hp}" Value="0">
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Setter Property="Text" Value="💀"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Hp}" Value="{x:Static sys:Double.NaN}">
                                            <Setter Property="Foreground" Value="Red"/>
                                            <Setter Property="Text" Value="❓"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Сила" Binding="{Binding Strange}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Состояние" Width="120" Binding="{Binding Status}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Hp}" Value="0">
                                    <Setter Property="Background" Value="LightGray"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Hp}" Value="{x:Static sys:Double.NaN}">
                                    <Setter Property="Background" Value="LightCoral"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="LightGray" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🔄 Обновить" 
                        Command="{Binding LoadCommand}" 
                        Width="100"
                        ToolTip="Обновить статистику"/>

                <Button Content="❌ Закрыть" 
                        Command="{Binding CloseCommand}" 
                        Width="100" 
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>