<Window x:Class="HeroApp.WPF.View.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:HeroApp.WPF.Converters"
        mc:Ignorable="d"
        Title="Управление героями - MVVM" 
        Height="700" 
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:GreaterThanConverter x:Key="GreaterThanConverter"/>
        <converters:LessThanConverter x:Key="LessThanConverter"/>
        <converters:HpToColorConverter x:Key="HpToColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Margin" Value="4,4,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="0" Background="LightGray">
            <Button Content="➕ Добавить героя" Command="{Binding AddHeroCommand}" ToolTip="Добавить нового героя"/>
            <Button Content="✏️ Редактировать" Command="{Binding EditHeroCommand}" 
                    ToolTip="Редактировать выбранного героя"
                    IsEnabled="{Binding SelectedHero, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="🗑️ Удалить" Command="{Binding DeleteHeroCommand}" 
                    ToolTip="Удалить выбранного героя"
                    IsEnabled="{Binding SelectedHero, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="⚔️ Нанести урон" Command="{Binding HitHeroCommand}" 
                    ToolTip="Нанести урон выбранному герою"
                    IsEnabled="{Binding SelectedHero, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Separator/>
            <Button Content="📊 Статистика" Command="{Binding ShowStatisticsCommand}" ToolTip="Показать статистику"/>
            <Button Content="👥 Показать расы" Command="{Binding ShowSpeciesCommand}" ToolTip="Показать все расы"/>
            <Separator/>
            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" ToolTip="Обновить данные"/>
        </ToolBar>

        <!-- Поиск и фильтры -->
        <Border Grid.Row="1" Background="AliceBlue" Padding="10" Margin="0,2,0,2">
            <StackPanel Orientation="Horizontal">
                <Label Content="Поиск:" FontWeight="Bold"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="200" 
                         ToolTip="Введите имя для поиска"/>

                <Separator Width="20" Visibility="Hidden"/>

                <Label Content="Раса:" FontWeight="Bold" Margin="20,0,0,0"/>
                <ComboBox ItemsSource="{Binding Species}" 
                          SelectedValue="{Binding SelectedSpeciesId}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Width="120"
                          ToolTip="Фильтр по расе">
                    <ComboBoxItem Content="Все расы" IsSelected="True"/>
                </ComboBox>

                <Separator Width="20" Visibility="Hidden"/>

                <Label Content="Состояние:" FontWeight="Bold" Margin="20,0,0,0"/>
                <ComboBox Width="100" ToolTip="Фильтр по состоянию">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Здоровые"/>
                    <ComboBoxItem Content="Раненые"/>
                    <ComboBoxItem Content="Мертвые"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Список героев -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Heroes}" 
                  SelectedItem="{Binding SelectedHero}"
                  SelectionMode="Single"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  RowDetailsVisibilityMode="VisibleWhenSelected">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Раса" Binding="{Binding SpeciesName}" Width="120"/>
                <DataGridTextColumn Header="HP" Width="80">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0:F1}">
                            <Binding Path="Hp"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Hp, Converter={StaticResource HpToColorConverter}}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Сила" Binding="{Binding Strange}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Гендер" Binding="{Binding Genre}" Width="80"/>
                <DataGridTextColumn Header="Тип урона" Binding="{Binding TypeOfDamage}" Width="120"/>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Hp}" Value="0">
                            <Setter Property="Background" Value="LightGray"/>
                            <Setter Property="Foreground" Value="Gray"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Hp}" Value="{x:Static sys:Double.NaN}">
                            <Setter Property="Background" Value="LightCoral"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Hp}" Value="{x:Null}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="LightYellow"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="LightYellow" Padding="10" Margin="10">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Раса: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding SpeciesName}"/>
                                <TextBlock Text=" | " Margin="10,0,10,0"/>
                                <TextBlock Text="Сила: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding Strange}"/>
                                <TextBlock Text=" | " Margin="10,0,10,0"/>
                                <TextBlock Text="HP: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding Hp, StringFormat=F1}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TypeOfDamage}" FontStyle="Italic" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <!-- Пагинация -->
        <Border Grid.Row="3" Background="WhiteSmoke" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="⏪ Первая" 
                        Command="{Binding FirstPageCommand}"
                        IsEnabled="{Binding CurrentPage, Converter={StaticResource GreaterThanConverter}, ConverterParameter=1}"/>

                <Button Content="◀️ Назад" 
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CurrentPage, Converter={StaticResource GreaterThanConverter}, ConverterParameter=1}"/>

                <TextBlock Text="{Binding CurrentPage}" 
                           VerticalAlignment="Center" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Margin="10,0"/>
                <TextBlock Text="из" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding TotalPages}" 
                           VerticalAlignment="Center" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Margin="0,0,10,0"/>

                <Button Content="Вперёд ▶️" 
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CurrentPage, Converter={StaticResource LessThanConverter}, ConverterParameter={Binding TotalPages}}"/>

                <Button Content="Последняя ⏩" 
                        Command="{Binding LastPageCommand}"
                        IsEnabled="{Binding CurrentPage, Converter={StaticResource LessThanConverter}, ConverterParameter={Binding TotalPages}}"/>

                <Separator Width="30" Visibility="Hidden"/>

                <Label Content="Размер страницы:" VerticalAlignment="Center"/>
                <ComboBox SelectedItem="{Binding PageSize}" Width="70" Margin="5">
                    <ComboBox.ItemsSource>
                        <x:Array Type="sys:Int32" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <sys:Int32>5</sys:Int32>
                            <sys:Int32>10</sys:Int32>
                            <sys:Int32>20</sys:Int32>
                            <sys:Int32>50</sys:Int32>
                            <sys:Int32>100</sys:Int32>
                        </x:Array>
                    </ComboBox.ItemsSource>
                </ComboBox>

                <Separator Width="30" Visibility="Hidden"/>

                <TextBlock Text="{Binding TotalItems, StringFormat='Всего героев: {0}'}" 
                           VerticalAlignment="Center" 
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Статус бар -->
        <StatusBar Grid.Row="4" Background="LightGray">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" FontStyle="Italic"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="100" Height="16" 
                                 IsIndeterminate="{Binding IsBusy}" 
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="Готово" 
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                               Margin="10,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>–