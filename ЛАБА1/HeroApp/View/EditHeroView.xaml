<Window x:Class="HeroApp.WPF.View.EditHeroView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Редактирование героя" 
        Height="450" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Margin" Value="5,5,0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="LightYellow" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Редактирование героя" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding OriginalHero.Name}" 
                           FontSize="14" 
                           FontStyle="Italic" 
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="Имя героя:*"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Раса -->
                <Label Grid.Row="1" Grid.Column="0" Content="Раса:*"/>
                <ComboBox Grid.Row="1" Grid.Column="1" 
                          ItemsSource="{Binding AvailableSpecies}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedSpeciesId}"/>
                <Label Grid.Row="2" Grid.Column="0" Content="Гендер:*"/>
                <ComboBox Grid.Row="2" Grid.Column="1" 
                          Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="Мужской"/>
                    <ComboBoxItem Content="Женский"/>
                    <ComboBoxItem Content="Другой"/>
                </ComboBox>

                <Label Grid.Row="3" Grid.Column="0" Content="Сила (1-1000):*"/>
                <Grid Grid.Row="3" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" 
                            Minimum="1" 
                            Maximum="1000" 
                            Value="{Binding Strange}"
                            TickFrequency="10"
                            TickPlacement="BottomRight"
                            AutoToolTipPlacement="TopLeft"
                            Margin="5,0"/>
                    <TextBlock Grid.Column="1" 
                               Text="{Binding Strange}" 
                               VerticalAlignment="Center" 
                               FontWeight="Bold"
                               Margin="10,0,0,0"
                               Width="30"/>
                </Grid>
                <Label Grid.Row="4" Grid.Column="0" Content="Тип урона:*"/>
                <ComboBox Grid.Row="4" Grid.Column="1" 
                          Text="{Binding TypeOfDamage, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True">
                    <ComboBoxItem Content="Меч"/>
                    <ComboBoxItem Content="Лук"/>
                    <ComboBoxItem Content="Топор"/>
                    <ComboBoxItem Content="Кинжалы"/>
                    <ComboBoxItem Content="Магия"/>
                    <ComboBoxItem Content="Посох"/>
                    <ComboBoxItem Content="Копье"/>
                </ComboBox>
                <Label Grid.Row="5" Grid.Column="0" Content="HP (1-10000):*"/>
                <Grid Grid.Row="5" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" 
                            Minimum="1" 
                            Maximum="10000" 
                            Value="{Binding Hp}"
                            TickFrequency="100"
                            TickPlacement="BottomRight"
                            AutoToolTipPlacement="TopLeft"
                            Margin="5,0"/>
                    <TextBlock Grid.Column="1" 
                               Text="{Binding Hp, StringFormat=F1}" 
                               VerticalAlignment="Center" 
                               FontWeight="Bold"
                               Margin="10,0,0,0"
                               Width="50"/>
                </Grid>
            </Grid>
        </StackPanel>
        <Border Grid.Row="2" 
                Background="LightPink" 
                CornerRadius="5" 
                Margin="0,10,0,5"
                Visibility="{Binding StatusMessage}">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="DarkRed" 
                       Margin="10,5" 
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="❌ Отмена" 
                    Command="{Binding CancelCommand}" 
                    Width="100" 
                    Background="LightCoral"/>

            <Button Content="💾 Сохранить" 
                    Command="{Binding SaveCommand}" 
                    Width="100" 
                    Margin="10,0,0,0"
                    Background="LightGreen"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>