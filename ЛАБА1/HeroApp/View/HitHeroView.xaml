<Window x:Class="HeroApp.WPF.View.HitHeroView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Нанесение урона герою" 
        Height="350" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="LightCoral" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Нанесение урона" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Hero.Name}" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Информация о герое -->
        <Border Grid.Row="1" Background="LightBlue" Padding="10" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="{Binding Hero.SpeciesName, StringFormat='Раса: {0}'}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Hero.Hp, StringFormat='Текущее HP: {0:F1}'}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Hero.Strange, StringFormat='Сила: {0}'}" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Урон -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Урон:" FontWeight="Bold"/>
            <Slider Minimum="0" 
                    Maximum="{Binding Hero.Hp, Converter={StaticResource DoubleMultiplierConverter}, ConverterParameter=2}"
                    Value="{Binding Damage}"
                    TickFrequency="10"
                    TickPlacement="BottomRight"
                    AutoToolTipPlacement="TopLeft"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="{Binding Damage, StringFormat='Урон: {0:F1}'}" 
                           FontWeight="Bold"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding Damage, StringFormat='{0:F1}'}" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="Red"/>
            </Grid>
        </StackPanel>

        <!-- Оставшееся HP -->
        <Border Grid.Row="3" 
                Background="{Binding RemainingHpColor, Converter={StaticResource ColorToBrushConverter}}" 
                Padding="10" 
                CornerRadius="5" 
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="Оставшееся HP:" 
                           FontWeight="Bold"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding RemainingHp, StringFormat='{0:F1}'}" 
                           FontSize="16" 
                           FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Предупреждения -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <Border Background="Red" 
                    CornerRadius="5" 
                    Padding="10"
                    Visibility="{Binding WillDie, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="⚠️ ВНИМАНИЕ: Герой погибнет!" 
                           FontWeight="Bold" 
                           Foreground="White"
                           TextWrapping="Wrap"/>
            </Border>

            <Border Background="Orange" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="0,5,0,0"
                    Visibility="{Binding WillBeWounded, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="⚠️ Герой будет ранен (HP &lt; 50)" 
                           FontWeight="Bold" 
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="❌ Отмена" 
                    Command="{Binding CancelCommand}" 
                    Width="100" 
                    Background="LightGray"/>

            <Button Content="⚔️ Нанести урон" 
                    Command="{Binding ApplyDamageCommand}" 
                    Width="120" 
                    Margin="10,0,0,0"
                    Background="{Binding WillDie, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Red|LightGreen}"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>