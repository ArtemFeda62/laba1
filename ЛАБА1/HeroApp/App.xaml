<Application x:Class="HeroApp.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:HeroApp.WPF.Converters"
             Startup="Application_Startup">

    <Application.Resources>
        <!-- Конвертеры -->
        <converters:GreaterThanConverter x:Key="GreaterThanConverter"/>
        <converters:LessThanConverter x:Key="LessThanConverter"/>
        <converters:HpToColorConverter x:Key="HpToColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:DoubleMultiplierConverter x:Key="DoubleMultiplierConverter"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>

        <!-- Стили -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Application.Resources>
</Application>