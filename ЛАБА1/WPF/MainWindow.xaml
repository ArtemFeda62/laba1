<local:BaseView x:Class="WpfView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfView.Infrastructure"
        Title="Hero Manager" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" ItemsSource="{Binding Heroes}" SelectedItem="{Binding SelectedHero}" 
                  AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Сила" Binding="{Binding Strange}"/>
                <DataGridTextColumn Header="HP" Binding="{Binding Hp}"/>
                <DataGridTextColumn Header="Раса" Binding="{Binding SpeciesName}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Редактирование:" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Имя:"/>
            <TextBox Text="{Binding SelectedHero.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
            <TextBlock Text="Сила:"/>
            <TextBox Text="{Binding SelectedHero.Strange, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
            <TextBlock Text="HP:"/>
            <TextBox Text="{Binding SelectedHero.Hp, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <Button Content="Обновить список" Command="{Binding RefreshCommand}" Margin="0,0,0,5"/>
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Margin="0,0,0,5"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Background="MistyRose"/>
        </StackPanel>
    </Grid>
</local:BaseView>